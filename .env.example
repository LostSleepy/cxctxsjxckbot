# Discord Bot Token (required)
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Groq API Key (required for AI chat commands)
# Get it from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Bot command prefix (default: cx!)
# COMMAND_PREFIX=cx!

# Admin Discord User ID (the bot owner, bypasses cooldowns/blacklist/maintenance)
# Defaults to the creator's ID; override here if you fork the bot
# ADMIN_ID=979869404110159912

# Announcement channel ID for Black Flash records and cx!anuncio
# 0 disables announcement features
# CANAL_ANUNCIOS_ID=1497645495051354113

# Internal bot channel ID (informational)
# CANAL_BOT_ID=1432506760698003466

# Groq model and token budget for cx!chat
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=200

# Web keep-alive server (needed on free hosting like Render/Railway)
# Set ENABLE_WEB=0 to disable (e.g. running behind your own process manager)
# ENABLE_WEB=1
# Web server port (most hosts inject PORT automatically)
# PORT=8080
